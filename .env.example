# Optional cloud sync (Settings → Account). Copy to .env.local and fill in
# your Supabase project's values; leave them out to build without sync.
# Only the *publishable* (anon) key belongs here, never the service_role key:
# it ends up in the app, and row-level security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
